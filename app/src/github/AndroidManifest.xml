<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The GitHub build updates itself: it asks GitHub for the latest release, downloads the
        APK and hands it to the system installer. That is all the network is used for; the
        components that would send usage statistics are removed in the main manifest.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
