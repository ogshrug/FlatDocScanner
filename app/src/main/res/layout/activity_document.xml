<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/document"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_pages_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/no_pages_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addPageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/action_add_page"
            android:src="@drawable/ic_camera"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.DocScanner.Circle" />

        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_low"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actionImport"
                style="@style/Widget.DocScanner.BarAction"
                android:text="@string/action_import_images"
                app:drawableTopCompat="@drawable/ic_import" />

            <TextView
                android:id="@+id/actionText"
                style="@style/Widget.DocScanner.BarAction"
                android:text="@string/action_text"
                app:drawableTopCompat="@drawable/ic_text" />

            <TextView
                android:id="@+id/actionShare"
                style="@style/Widget.DocScanner.BarAction"
                android:text="@string/action_share"
                app:drawableTopCompat="@drawable/ic_share" />

            <TextView
                android:id="@+id/actionPdf"
                style="@style/Widget.DocScanner.BarAction"
                android:text="@string/create_pdf"
                app:drawableTopCompat="@drawable/ic_pdf" />

            <TextView
                android:id="@+id/actionMore"
                style="@style/Widget.DocScanner.BarAction"
                android:text="@string/action_more"
                app:drawableTopCompat="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
