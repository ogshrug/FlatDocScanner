<resources>
    <!-- Dark only, whatever the system setting: teal on near-black. -->
    <style name="Theme.DocScanner" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorTertiary">@color/accent_bright</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_highest</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_low</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_highest</item>
        <item name="colorSurfaceInverse">@color/text_primary</item>
        <item name="colorOnSurfaceInverse">@color/background</item>
        <item name="colorPrimaryInverse">@color/accent_container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorHighlight">@color/accent_container</item>

        <!-- Main actions are solid accent with dark text. -->
        <item name="floatingActionButtonStyle">@style/Widget.DocScanner.Fab</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.DocScanner.ExtendedFab</item>
        <item name="toolbarStyle">@style/Widget.DocScanner.Toolbar</item>
        <item name="snackbarStyle">@style/Widget.DocScanner.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.DocScanner.SnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/Widget.DocScanner.SnackbarText</item>
    </style>

    <style name="Widget.DocScanner.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.DocScanner.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.DocScanner.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Material 3 "primary" FABs use the muted container colour; ours are solid accent. -->
    <style name="Widget.DocScanner.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/on_accent</item>
        <item name="rippleColor">@color/accent_bright</item>
    </style>

    <style name="Widget.DocScanner.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="rippleColor">@color/accent_bright</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DocScanner.Circle</item>
    </style>

    <!-- Undo and confirmations: a raised dark card, not the default light inverse surface. -->
    <style name="Widget.DocScanner.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/surface_highest</item>
        <item name="actionTextColorAlpha">1</item>
    </style>

    <style name="Widget.DocScanner.SnackbarText" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.DocScanner.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.DocScanner.SheetLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- A button in the bottom action bars: icon above a short label. -->
    <style name="Widget.DocScanner.BarAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/bar_action_text</item>
        <item name="drawableTint">@color/bar_action_text</item>
    </style>

    <!-- A capture option in the camera: icon above its name, teal while switched on. -->
    <style name="Widget.DocScanner.CameraOption" parent="">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/camera_option_tint</item>
        <item name="drawableTint">@color/camera_option_tint</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Theme.DocScanner.Camera">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
