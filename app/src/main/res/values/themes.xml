<resources>
    <!-- The base theme. Which colours it shows is decided at run time: see AppTheme.kt
         and theme_overlays.xml. Light or dark follows the Appearance setting. -->
    <style name="Theme.DocScanner" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colours and corner radii: the Teal theme's, until AppTheme lays the chosen
             theme's overlay on top. Listed here too so that the window shown while the app
             starts already has them. -->
        <item name="colorPrimary">@color/teal_accent</item>
        <item name="colorOnPrimary">@color/teal_on_accent</item>
        <item name="colorPrimaryContainer">@color/teal_accent_c</item>
        <item name="colorOnPrimaryContainer">@color/teal_on_accent_c</item>
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="colorOnSecondary">@color/teal_on_accent</item>
        <item name="colorSecondaryContainer">@color/teal_accent_c</item>
        <item name="colorOnSecondaryContainer">@color/teal_on_accent_c</item>
        <item name="colorTertiary">@color/teal_accent_bright</item>
        <item name="colorOnTertiary">@color/teal_on_accent</item>
        <item name="colorError">@color/teal_error</item>
        <item name="colorOnError">@color/teal_on_error</item>
        <item name="android:colorBackground">@color/teal_bg</item>
        <item name="colorOnBackground">@color/teal_text</item>
        <item name="colorSurface">@color/teal_bg</item>
        <item name="colorOnSurface">@color/teal_text</item>
        <item name="colorSurfaceVariant">@color/teal_s_highest</item>
        <item name="colorOnSurfaceVariant">@color/teal_text2</item>
        <item name="colorTextMuted">@color/teal_text3</item>
        <item name="colorSurfaceContainerLowest">@color/teal_s_lowest</item>
        <item name="colorSurfaceContainerLow">@color/teal_s_low</item>
        <item name="colorSurfaceContainer">@color/teal_s</item>
        <item name="colorSurfaceContainerHigh">@color/teal_s_high</item>
        <item name="colorSurfaceContainerHighest">@color/teal_s_highest</item>
        <item name="colorSurfaceInverse">@color/teal_text</item>
        <item name="colorOnSurfaceInverse">@color/teal_bg</item>
        <item name="colorPrimaryInverse">@color/teal_accent_c</item>
        <item name="colorOutline">@color/teal_outline</item>
        <item name="colorOutlineVariant">@color/teal_divider</item>
        <item name="android:textColorHighlight">@color/teal_accent_c</item>
        <item name="android:textColorPrimary">@color/teal_text</item>
        <item name="android:textColorSecondary">@color/teal_text2</item>
        <item name="android:textColorTertiary">@color/teal_text3</item>
        <item name="android:textColorHint">@color/teal_text3</item>
        <item name="radiusInner">8dp</item>
        <item name="radiusElement">12dp</item>
        <item name="radiusContainer">12dp</item>
        <item name="radiusPage">28dp</item>
        <item name="radiusFull">999dp</item>
        <item name="headingFont">sans-serif</item>

        <!-- Resolved after the overlay, so the window takes the chosen theme's background. -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>

        <!-- Material's shape scale, driven by the theme's radii. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.DocScanner.Inner</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.DocScanner.Element</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.DocScanner.Container</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.DocScanner.Container</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.DocScanner.Page</item>

        <!-- Main actions are solid accent. -->
        <item name="floatingActionButtonStyle">@style/Widget.DocScanner.Fab</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.DocScanner.ExtendedFab</item>
        <item name="toolbarStyle">@style/Widget.DocScanner.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DocScanner.BottomSheet</item>
        <item name="snackbarStyle">@style/Widget.DocScanner.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.DocScanner.SnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/Widget.DocScanner.SnackbarText</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Inner" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">?attr/radiusInner</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Element" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">?attr/radiusElement</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Container" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">?attr/radiusContainer</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Page" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">?attr/radiusPage</item>
    </style>

    <!-- Sheets run down behind the navigation bar instead of stopping above it. -->
    <style name="ThemeOverlay.DocScanner.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>

    <style name="Widget.DocScanner.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.DocScanner.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.DocScanner.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">?attr/headingFont</item>
        <item name="fontFamily">?attr/headingFont</item>
    </style>

    <!-- Material 3 "primary" FABs use the muted container colour; ours are solid accent. -->
    <style name="Widget.DocScanner.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="rippleColor">?attr/colorTertiary</item>
    </style>

    <style name="Widget.DocScanner.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="rippleColor">?attr/colorTertiary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DocScanner.Circle</item>
    </style>

    <!-- Undo and confirmations: a raised dark card, not the default light inverse surface. -->
    <style name="Widget.DocScanner.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="actionTextColorAlpha">1</item>
    </style>

    <style name="Widget.DocScanner.SnackbarText" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.DocScanner.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.DocScanner.SheetLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- A button in the bottom action bars: icon above a short label. -->
    <style name="Widget.DocScanner.BarAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/bar_action_text</item>
        <item name="drawableTint">@color/bar_action_text</item>
    </style>

    <!-- A capture option in the camera: icon above its name, teal while switched on. -->
    <style name="Widget.DocScanner.CameraOption" parent="">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/camera_option_tint</item>
        <item name="drawableTint">@color/camera_option_tint</item>
    </style>

    <!-- A pill in most themes; square where the theme has no rounding at all. -->
    <style name="ShapeAppearance.DocScanner.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">?attr/radiusFull</item>
    </style>

    <style name="ShapeAppearance.DocScanner.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">?attr/radiusInner</item>
    </style>

    <style name="Theme.DocScanner.Camera">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
