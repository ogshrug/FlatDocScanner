<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+.
    Cloud backup (Google account, 25 MB limit): settings only. Scans are large and private,
    so they never go to the cloud.
    Device-to-device transfer (setting up a new phone from the old one): everything, so
    scans move with you.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="documents/" />
    </device-transfer>
</data-extraction-rules>
